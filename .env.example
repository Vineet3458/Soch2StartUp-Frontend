# ── Frontend Environment Configuration ───────────────────────

# Production Backend API URL (Hosted on Render):
# Configure this in your Vercel Project Settings > Environment Variables.
# It can be with or without trailing /api (the client handles normalization).
# Example: https://soch2startup-backend.onrender.com/api
VITE_API_URL=https://your-backend-service.onrender.com/api

# Local Development Proxy Target (used by Vite dev server when VITE_API_URL is unset)
# VITE_PROXY_TARGET=http://localhost:5000
